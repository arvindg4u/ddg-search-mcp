# MCP Authentication Token
# Clients must include this in the Authorization header:
#   Authorization: Bearer YOUR_TOKEN
# Leave unset to disable authentication (local dev only).
MCP_API_TOKEN=

# Server port (default: 10000)
PORT=

# Search request timeout in seconds (default: 10)
DDGS_TIMEOUT=10

# Search proxy (optional, e.g. http://user:pass@host:port or "tb" for Tor).
# Use this if your host's IP is blocked by search engines (common on
# Render / Vercel / Heroku datacenter IPs) — see README troubleshooting.
DDGS_PROXY=

# Default search backend for all tools (default: auto = try all engines).
# One of: auto, duckduckgo, bing, brave, google, mojeek, startpage,
# wikipedia, yahoo, grokipedia (availability varies by tool).
DDGS_BACKEND=auto
